# =============================================================================
# ApplyMate AI — Backend Environment Configuration
# =============================================================================

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/applymate

# Security / JWT
JWT_SECRET_KEY=change-me-in-production-random-secure-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Supabase Storage & Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=applymate-files

# Job Providers API Credentials
ADZUNA_APP_ID=
ADZUNA_API_KEY=
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api

# App Settings
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
